#!/usr/bin/env bash
# Finds deleted remote branches and deletes the local references as well as any matching local branches.
# Branches checked out in another worktree prompt for worktree removal first.

main() {
  local -r remote="origin"
  git fetch --prune "${remote}"
  git worktree prune

  local -A candidates
  local -A worktrees
  local branch upstream track worktree

  local current_branch
  current_branch="$(git branch --show-current)"

  local -a remote_refs
  mapfile -t remote_refs < <(git branch -r | sed 's/^ *//' | sed "s|^${remote}/||")

  while IFS=$'\t' read -r branch upstream track worktree; do
    [[ -n "${branch}" ]] || continue
    [[ "${branch}" == "${current_branch}" ]] && continue

    if [[ -n "${upstream}" ]]; then
      # Has an upstream: candidate only if it's gone
      [[ "${track}" == "[gone]" ]] || continue
    else
      # No upstream: candidate only if no matching remote branch exists
      local found=0
      for ref in "${remote_refs[@]}"; do
        if [[ "${ref}" == "${branch}" ]]; then
          found=1
          break
        fi
      done
      [[ ${found} -eq 0 ]] || continue
    fi

    candidates["${branch}"]=1
    [[ -n "${worktree}" ]] && worktrees["${branch}"]="${worktree}"
  done < <(git for-each-ref refs/heads --format='%(refname:short)%09%(upstream)%09%(upstream:track)%09%(worktreepath)')

  local prompt_response
  for branch in "${!candidates[@]}"; do
    if [[ -n "${worktrees[${branch}]:-}" ]]; then
      read -r -p "Remove worktree '${worktrees[${branch}]}' and branch '${branch}'? [Y/n] " prompt_response
      if [[ "${prompt_response}" == 'n' || "${prompt_response}" == 'N' ]]; then
        continue
      fi
      if ! git worktree remove "${worktrees[${branch}]}"; then
        echo "Skipping '${branch}': worktree removal failed (dirty? try 'git worktree remove --force ${worktrees[${branch}]}')" >&2
        continue
      fi
    else
      read -r -p "Remove branch '${branch}'? [Y/n] " prompt_response
      if [[ "${prompt_response}" == 'n' || "${prompt_response}" == 'N' ]]; then
        continue
      fi
    fi
    git branch -D "${branch}"
  done
}

main "$@"
